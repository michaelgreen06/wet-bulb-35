<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Current Wet Bulb Temperature</title>
  <meta name="description" content="Get real-time wet bulb temperature, humidity, and air temperature for your location or browse our static location index.">
