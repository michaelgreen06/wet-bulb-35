    "generate-hotspots": "tsx -r tsconfig-paths/register scripts/generate-hotspots.ts",
    "generate-inhabited-hotspots": "tsx -r tsconfig-paths/register scripts/generate-inhabited-hotspots.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@shadcn/ui": "^0.0.4",
    "@types/google.maps": "^3.58.1",
