{
  "name": "wetbulb2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "generate-sitemaps": "node scripts/generate-sitemaps.js",
    "generate:city-population": "node scripts/build-city-population.mjs",
    "generate:legacy-city-route-redirects": "node scripts/generate-legacy-city-route-redirects.mjs",
    "generate:popular-40-enrichment": "python3 scripts/generate-popular-40-enrichment.py",
    "generate:location-facts": "python3 scripts/generate-location-facts.py",
    "generate:climate-context": "python3 scripts/generate-climate-context.py",
    "plan:nasa-power-cells": "python3 scripts/fetch-nasa-power-cells.py",
    "test:location-facts": "node --test tests/location-facts.test.mjs && python3 -m unittest tests/test_location_facts_generator.py",
    "test:climate-context": "node --test tests/climate-context.test.mjs && python3 -m unittest tests/test_climate_context_pipeline.py",
    "test:popular-40-enrichment": "node --test tests/popular-40-enrichment.test.mjs && python3 tests/test_popular_40_enrichment_generator.py",
    "test:forecast": "vitest run tests/forecast-engine.test.ts tests/open-meteo-forecast.test.ts tests/forecast-edge.test.ts tests/forecast-ifs-freshness.test.ts && node --test tests/forecast-ui.test.mjs tests/forecast-run-labels.test.mjs",
    "build:hotspot-city-manifest": "node scripts/build-hotspot-city-manifest.mjs --source=scripts/resolved_cities.json --out=.hotspots/cities.json",
    "generate:hotspot-snapshot": "node --experimental-strip-types scripts/generate-inhabited-hotspot-snapshot.ts",
    "generate:global-grid-hotspot-snapshot": "python3 scripts/generate-global-grid-hotspot-snapshot.py",
    "test:global-hotspots": "vitest run tests/hotspot-open-meteo.test.ts tests/hotspot-pipeline.test.ts tests/hotspot-snapshot.test.ts tests/hotspots-edge.test.ts tests/hotspot-ui.test.ts tests/global-grid-hotspots-edge.test.ts tests/global-grid-hotspot-ui.test.ts tests/hotspot-pinned-five-day.test.ts && node --test tests/hotspot-manifest.test.mjs tests/hotspot-publish-guard.test.mjs tests/hotspot-pair-budget.test.mjs tests/hotspot-pair-publication.test.mjs tests/hotspot-navigation.test.mjs",
    "build": "next build",
    "build:static-prototype": "node scripts/prototype-static-generator.mjs --limit=130686 --out=dist",
    "build:vercel-output": "node scripts/build-vercel-output.mjs",
    "build:hono-binding-assets": "node scripts/build-hono-binding-assets.mjs --source=scripts/resolved_cities.json --out=worker-assets",
    "build:hono-renderer-assets": "npm run test:forecast && npm run test:global-hotspots && npm run test:location-facts && npm run test:climate-context && node --test tests/popular-40-enrichment.test.mjs && node scripts/build-hono-renderer-assets.mjs --source=scripts/resolved_cities.json --out=worker-assets",
    "test:hono-binding-probe": "node --test tests/hono-binding-probe.test.mjs",
    "test:hono-page-renderer": "node --test tests/hono-page-renderer.test.mjs tests/legacy-city-route-redirects.test.mjs",
    "test:tier1-cities": "node --test tests/tier1-city-prominence.test.mjs tests/sitemap-seo-phase2.test.mjs",
    "test:weather-edge": "node --test tests/weather-edge.test.mjs tests/weather-turnstile.test.mjs tests/weather-turnstile-ui.test.mjs",
    "test:staging-parity": "node --test tests/staging-parity-gate.test.mjs",
    "test:detached-process-registry": "node --test tests/detached-process-registry.test.mjs",
    "test:production-release-monitor": "node --test tests/production-release-monitor.test.mjs",
    "test:apex-redirect": "node --test tests/apex-redirect.test.mjs",
    "test:gsc-tracker": "python3 -m unittest tests/test_gsc_tracker.py",
    "test:analytics-events": "node --test tests/analytics-events.test.mjs",
    "test:admin-dashboard": "node --test tests/admin-dashboard.test.mjs && python3 -m unittest tests/test_admin_status_collector.py",
    "dry-run:admin-dashboard": "./node_modules/.bin/wrangler deploy --dry-run --config wrangler.admin-dashboard.toml --outdir .wrangler/admin-dashboard-dry-run",
    "test:ga4-reporting": "python3 -m unittest tests/test_wetbulb_ga4.py tests/test_generate_ga4_weekly_report.py tests/test_check_ga4_traffic_spike.py",
    "check:staging-parity": "node scripts/staging-parity-gate.mjs",
    "generate:hono-renderer-goldens": "node scripts/generate-hono-renderer-goldens.mjs",
    "dry-run:hono-binding-probe": "npm run build:hono-binding-assets && ./node_modules/.bin/wrangler deploy --dry-run --config wrangler.staging.toml",
    "dry-run:hono-page-renderer": "npm run build:hono-renderer-assets && ./node_modules/.bin/wrangler deploy --dry-run --config wrangler.renderer-staging.toml",
    "dry-run:weather-edge": "npm run build:hono-renderer-assets && ./node_modules/.bin/wrangler deploy --dry-run --config wrangler.weather-staging.toml",
    "dry-run:weather-production-domain": "npm run build:hono-renderer-assets && ./node_modules/.bin/wrangler deploy --dry-run --config wrangler.weather-production-domain.toml",
    "dry-run:apex-redirect-production": "./node_modules/.bin/wrangler deploy --dry-run --config wrangler.apex-redirect-production.toml",
    "deploy:weather-staging": "npm run build:hono-renderer-assets && npm run test:hono-page-renderer && ./node_modules/.bin/wrangler deploy --config wrangler.weather-staging.toml",
    "tail:weather-staging-safe": "node scripts/wrangler-tail-sanitizer.mjs",
    "dry-run:rollback-cutover-rehearsal": "node scripts/rollback-cutover-rehearsal.mjs --dry-run",
    "load:staging-safe": "node scripts/staging-load-harness.mjs --mode=fake",
    "vercel-build": "npm run test:static-prototype && npm run test:tier1-cities && npm run test:popular-40-enrichment && npm run test:forecast && npm run build:vercel-output",
    "test:static-prototype": "node --test tests/static-generator.test.mjs tests/vercel-ignore-build.test.mjs tests/nearby.test.mjs tests/city-population.test.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --exclude '**/*.mjs' && node --test tests/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@shadcn/ui": "^0.0.4",
    "@types/google.maps": "^3.58.1",
    "csvtojson": "^2.0.10",
    "date-fns": "^4.1.0",
    "hono": "^4.13.7",
    "JSONStream": "^1.3.5",
    "next": "15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "slugify": "^1.6.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wrangler": "4.129.1"
  }
}
